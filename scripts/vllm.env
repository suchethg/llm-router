# vLLM settings shared by bench.sh and vllm-mac.sh; environment variables of
# the same name override them. These fit 2 replicas of the 4-bit 0.6B model
# on an 18 GB Mac (each uses ~3.7 GB). The KV cache size varies per start,
# roughly 6,000-10,400 tokens; vllm-metal logs it as "CPU KV cache size".
: "${MODEL:=mlx-community/Qwen3-0.6B-4bit}"
: "${VLLM_ARGS:=--enable-prefix-caching --gpu-memory-utilization 0.15 --max-num-seqs 8 --max-num-batched-tokens 1024 --max-model-len 4096}"
